---
// Every page's shell, in the A2 style of docs/harness/visual-design.md: the
// lockup header and nav, an optional hero, the full-width content area,
// flash messages from a form redirect (?error= / ?notice=), the footer, and
// live sync across a user's devices.
import Alert from "../components/Alert.astro";
import Crest from "../components/Crest.astro";
import "../styles.css";

interface Props {
  title: string;
  description?: string;
  /** Which nav item a page belongs to, when the path doesn't say (a course
   *  page belongs to the dashboard while running, the archive once graded). */
  section?: string;
}

const { title, description = "Your ANU results archive and GPA planner.", section } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const error = Astro.url.searchParams.get("error");
const notice = Astro.url.searchParams.get("notice");

// Logged out there are no links: every logged-out page is, or leads to, the
// login. Staff get their own, shorter nav (docs/harness/visual-design.md).
// About (/readme/) is footer-only (visual-design.md).
const links = user?.role === "staff"
  ? [{ href: "/staff/", label: "My courses", current: path.startsWith("/staff") }]
  : user
  ? [
      { href: "/", label: "Dashboard", current: section ? section === "/" : path === "/" },
      { href: "/archive/", label: "Archive", current: section ? section === "/archive/" : path.startsWith("/archive") },
      { href: "/planner/", label: "Planner", current: path.startsWith("/planner") },
    ]
  : [];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdfcfa" />
    <title>{title} · ANU Grades</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body data-signed-in={user ? "" : undefined}>
    <header>
      <div class="site-header">
        <nav class:list={["wrap", { "nav-collapsible": !!user }]} aria-label="Main">
          <a class="lockup" href="/">
            <Crest />
            <span>ANU<span class="slash">/</span>Grades</span>
          </a>
          {
            user && (
              <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="nav-links">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
                <span class="visually-hidden">Menu</span>
              </button>
            )
          }
          {
            user && (
              <ul class="nav-links" id="nav-links">
                {
                  links.map((l) => (
                    <li>
                      <a href={l.href} aria-current={l.current ? "page" : undefined}>
                        {l.label}
                      </a>
                    </li>
                  ))
                }
                {
                  user && (
                    <li>
                      <form method="post" action="/api/logout">
                        <button type="submit">Log out</button>
                      </form>
                    </li>
                  )
                }
              </ul>
            )
          }
        </nav>
      </div>
      <slot name="hero" />
    </header>
    <main id="main" class="wrap">
      {error && <Alert kind="error">{error}</Alert>}
      {notice && <Alert kind="notice">{notice}</Alert>}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>ANU Grades is a student prototype built for COMP4020, not the official ANU record.</p>
        <p>GPA and grade rules follow ANU's published grading scale and GPA pages. <a href="/readme/">About this app</a></p>
      </div>
    </footer>
    {
      user && (
        <div class="sync-banner" role="status" hidden>
          <span>{user.role === "staff" ? "Something changed in another tab." : "Your results have changed."}</span>
          <button type="button" data-refresh>
            Refresh
          </button>
        </div>
      )
    }
    <script>
      // Phone menu: fold the logged-in links behind a button. Without JS
      // the links just show in a row, so nothing depends on this.
      const nav = document.querySelector<HTMLElement>(".nav-collapsible");
      const toggle = nav?.querySelector<HTMLButtonElement>(".menu-toggle");
      toggle?.addEventListener("click", () => {
        const open = nav!.classList.toggle("open");
        toggle.setAttribute("aria-expanded", String(open));
      });

      // Live sync: when this student's data changes in another tab or on
      // another device, offer a refresh rather than reloading under them
      // (they might be halfway through typing a mark).
      if (document.body.hasAttribute("data-signed-in")) {
        const banner = document.querySelector<HTMLElement>(".sync-banner");
        const source = new EventSource("/api/events");
        source.addEventListener("changed", () => {
          if (banner) banner.hidden = false;
        });
        document.querySelector("[data-refresh]")?.addEventListener("click", () => {
          // drop any one-off ?notice= so it doesn't show again
          location.replace(location.pathname + location.hash);
        });
      }
    </script>
  </body>
</html>
