---
// "/" is just the login for visitors, and the student dashboard once logged
// in. Staff land on /staff/. Functional only (docs/harness/visual-design.md).
import CourseCard from "../components/CourseCard.astro";
import LoginForm from "../components/LoginForm.astro";
import Stat from "../components/Stat.astro";
import Layout from "../layouts/Layout.astro";
import { isDemoAccount, listStudentCourses } from "../lib/data";
import { fmtGpa, plural } from "../lib/format";
import { summarise } from "../lib/record";

const user = Astro.locals.user;
if (user?.role === "staff") return Astro.redirect("/staff/", 303);
const student = user;
const summary = student ? summarise(student, listStudentCourses(student.uniId)) : null;
const current = summary?.courses.filter((v) => v.inProgress) ?? [];
const plan = summary?.plan;
---

<Layout title={student ? "Dashboard" : "Log in"}>
  {
    !student && (
      <div class="narrow">
        <h1>Log in</h1>
        <p class="lede">Your ANU results, GPA and what you need to hit your targets.</p>
        <section class="card" aria-label="Log in">
          <LoginForm idPrefix="home" />
        </section>
      </div>
    )
  }
  {
    student && summary && (
      <>
        <div class="page-head">
          <div>
            <h1>Hi, {student.name.split(" ")[0]}</h1>
            {plan?.status === "possible" && (
              <p class="lede">
                To reach your target GPA of {plan.target.toFixed(3)} you need to average{" "}
                {plan.neededAverage!.toFixed(2)} grade points over your remaining {plural(plan.remainingUnits, "unit")}.{" "}
                <a href="/planner/">Planner</a>
              </p>
            )}
            {plan?.status === "secured" && <p class="lede">You've already secured your target GPA of {plan.target.toFixed(3)}.</p>}
            {plan?.status === "out-of-reach" && (
              <p class="lede">
                Your target GPA of {plan.target.toFixed(3)} is out of reach; straight HDs would reach {fmtGpa(plan.bestPossible)}.{" "}
                <a href="/planner/">Planner</a>
              </p>
            )}
            {!plan && (
              <p class="lede">
                <a href="/planner/">Set a target GPA</a> to see what the rest of your degree needs.
              </p>
            )}
          </div>
          <dl class="stats stats-2">
            <Stat label="Career GPA" value={fmtGpa(summary.gpa)} note={`over ${summary.gpaUnits} units`} />
            <Stat
              label="Career GPA if you hit targets"
              value={fmtGpa(summary.projectedGpa)}
              note={summary.projectedGpa === null ? "set course targets" : "after this semester"}
            />
          </dl>
        </div>

        <h2>This semester</h2>
        {current.length > 0 && (
          <p class="section-hint">A dashed grade is where you're tracking now, not a released result.</p>
        )}
        {current.length === 0 ? (
          <div class="empty">
            <p>No courses in progress. Courses appear here when your convenor enrols you.</p>
          </div>
        ) : (
          <ul class="course-list">
            {current.map((v) => (
              <CourseCard view={v} showNeeded />
            ))}
          </ul>
        )}
        <p style="margin-top:1.5rem">
          <a href="/archive/">All your past results</a>
        </p>

        {isDemoAccount(student.uniId) && (
          <form method="post" action="/api/demo/reset" class="small muted" style="margin-top:2rem">
            This is the shared demo account.{" "}
            <button type="submit" class="link-button">
              Reset demo data
            </button>
          </form>
        )}
      </>
    )
  }
</Layout>
