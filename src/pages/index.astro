---
// "/" is the landing page for visitors (hero, login, what the app does) and
// the dashboard once logged in. There's no "Home" in the nav; the lockup
// links here.
import Alert from "../components/Alert.astro";
import CourseCard from "../components/CourseCard.astro";
import Field from "../components/Field.astro";
import PageHeader from "../components/PageHeader.astro";
import Stat from "../components/Stat.astro";
import Layout from "../layouts/Layout.astro";
import { DEMO_PASSWORD, DEMO_UNI_ID, listCourses } from "../lib/data";
import { fmtGpa, plural } from "../lib/format";
import { summarise } from "../lib/record";

const student = Astro.locals.student;
const summary = student ? summarise(student, listCourses(student.id)) : null;
const current = summary?.courses.filter((v) => v.inProgress) ?? [];
const latest = summary?.semesters.find((s) => !s.inProgress);
const plan = summary?.plan;
---

<Layout title={student ? "Dashboard" : "Your grades, in one place"}>
  {
    !student && (
      <section class="hero" slot="hero">
        <div class="hero-inner">
          <h1>Your grades, in one place</h1>
          <p>
            Every released result with its assessment breakdown, your GPA worked out the ANU way, and a plain
            answer to "what do I need on the final?"
          </p>
        </div>
      </section>
    )
  }
  {
    !student && (
      <>
        <div class="two-col">
          <section class="card" aria-labelledby="login-heading">
            <h2 id="login-heading">Log in</h2>
            <form method="post" action="/api/login">
              <input type="hidden" name="next" value="/" />
              <Field
                id="home-uni-id"
                label="Uni ID"
                name="uniId"
                required
                autocomplete="username"
                autocapitalize="none"
                placeholder="u1234567"
              />
              <Field
                id="home-password"
                label="Password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
              />
              <button type="submit" class="button-block">
                Log in
              </button>
            </form>
            <p class="small" style="margin:0.75rem 0 0">
              New here? <a href="/register/">Create an account</a>
            </p>
          </section>
          <div>
            <Alert kind="info">
              <strong>Just looking?</strong> Log in as the demo student: uni ID <code>{DEMO_UNI_ID}</code>, password{" "}
              <code>{DEMO_PASSWORD}</code>.
            </Alert>
            <p class="small muted">
              This is a prototype with its own accounts and illustrative data. It isn't connected to ISIS, so
              don't use your real ANU password.
            </p>
          </div>
        </div>

        <h2>What you can do</h2>
        <div class="two-col">
          <section class="card">
            <h3>See your archive</h3>
            <p style="margin:0">
              Every course by session, with its released grade and each assessment mark behind it.
            </p>
          </section>
          <section class="card">
            <h3>Know your GPA</h3>
            <p style="margin:0">
              Calculated on ANU's 7-point scale: grade points × units, fails included, WD and CRS left out.
            </p>
          </section>
          <section class="card">
            <h3>Plan each course</h3>
            <p style="margin:0">
              Set a target grade and see exactly what you need on the final exam or the last assignments.
            </p>
          </section>
          <section class="card">
            <h3>Plan your degree</h3>
            <p style="margin:0">
              Set a target GPA and see what your remaining semesters need to average to get there.
            </p>
          </section>
        </div>
      </>
    )
  }
  {
    student && summary && (
      <>
        <PageHeader title={`Hi, ${student.name.split(" ")[0]}`} lede="Your results at a glance, and what's still in play this semester." />
        <dl class="stats">
          <Stat label="Career GPA" value={fmtGpa(summary.gpa)} note={`over ${summary.gpaUnits} units`} />
          <Stat
            label="Target GPA"
            value={student.targetGpa === null ? "—" : student.targetGpa.toFixed(3)}
            note={student.targetGpa === null ? "not set" : "your goal"}
          />
          <Stat
            label="If you hit targets"
            value={fmtGpa(summary.projectedGpa)}
            note={summary.projectedGpa === null ? "set course targets" : "this semester"}
          />
          <Stat label="Units passed" value={String(summary.creditUnits)} note={`of ${summary.degreeUnits}`} />
        </dl>

        {plan && (
          <section class="card needed" aria-labelledby="plan-heading">
            <h2 id="plan-heading">Your target GPA</h2>
            {plan.status === "possible" && (
              <p>
                To reach <strong>{plan.target.toFixed(3)}</strong> you need to average{" "}
                <strong>{plan.neededAverage!.toFixed(2)} grade points</strong> across your remaining{" "}
                {plural(plan.remainingUnits, "unit")}.
              </p>
            )}
            {plan.status === "secured" && <p>You've already secured {plan.target.toFixed(3)}. Keep it up.</p>}
            {plan.status === "out-of-reach" && (
              <p>
                {plan.target.toFixed(3)} is out of reach: straight HDs from here would reach{" "}
                {fmtGpa(plan.bestPossible)}.
              </p>
            )}
            {plan.status === "no-units" && <p>You have no units left to change your GPA.</p>}
            <a href="/planner/">Open the planner</a>
          </section>
        )}

        <h2>This semester</h2>
        {current.length === 0 ? (
          <p class="muted">No courses in progress. Add one to plan what you need.</p>
        ) : (
          <ul class="course-list">
            {current.map((v) => (
              <CourseCard view={v} showNeeded />
            ))}
          </ul>
        )}
        <p>
          <a class="button button-secondary" href="/courses/new/">
            Add a course
          </a>
        </p>

        {latest && (
          <>
            <h2>Latest results: {latest.label}</h2>
            <ul class="course-list">
              {latest.courses.map((v) => (
                <CourseCard view={v} />
              ))}
            </ul>
            <p>
              <a href="/archive/">See your full archive</a>
            </p>
          </>
        )}

        {student.uniId === DEMO_UNI_ID && (
          <section class="card" aria-labelledby="demo-heading">
            <h2 id="demo-heading">Demo account</h2>
            <p class="small">Everyone shares this account. Put it back to its starting history any time.</p>
            <form method="post" action="/api/demo/reset">
              <button type="submit" class="button-secondary">
                Reset demo data
              </button>
            </form>
          </section>
        )}
      </>
    )
  }
</Layout>
