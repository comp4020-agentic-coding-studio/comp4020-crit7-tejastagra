---
import LoginForm from "../../components/LoginForm.astro";
import PageHeader from "../../components/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";
import { safeNext } from "../../lib/forms";

const next = safeNext(Astro.url.searchParams.get("next"), "");
const user = Astro.locals.user;
if (user) return Astro.redirect(user.role === "staff" ? "/staff/" : "/", 303);
---

<Layout title="Log in">
  <div class="narrow">
    <PageHeader title="Log in" lede="Students see their results; staff manage their courses." />
    <section class="card">
      <LoginForm idPrefix="login" next={next} />
    </section>
  </div>
</Layout>
