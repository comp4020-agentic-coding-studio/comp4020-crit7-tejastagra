---
// The GPA planner: set a target GPA and see what the rest of the degree has
// to average. One result, one scale (UI/UX review): the needed average is
// grade points per unit; the career-GPA range is labelled as a different
// quantity so the two don't read as contradicting each other.
import Field from "../../components/Field.astro";
import GradeBadge from "../../components/GradeBadge.astro";
import Stat from "../../components/Stat.astro";
import Layout from "../../layouts/Layout.astro";
import { listStudentCourses } from "../../lib/data";
import { fmtGpa, plural } from "../../lib/format";
import type { GradeMix } from "../../lib/grading";
import { summarise } from "../../lib/record";

const student = Astro.locals.user!;
const summary = summarise(student, listStudentCourses(student.uniId));
const plan = summary.plan;

// translate an average in grade points to the nearest grade words
function describeAverage(avg: number): string {
  if (avg > 6.5) return "mostly HDs";
  if (avg > 6) return "a mix of HDs and Ds";
  if (avg > 5.5) return "mostly Ds";
  if (avg > 5) return "a mix of Ds and CRs";
  if (avg > 4.5) return "mostly CRs";
  if (avg > 4) return "a mix of CRs and Ps";
  return "passes";
}

function mixLine(mix: GradeMix): { grade: string; courses: number }[] {
  return [mix.higher, ...(mix.lower ? [mix.lower] : [])];
}
const after = plan?.afterTargets;
---

<Layout title="GPA planner">
  <div class="page-head">
    <div>
      <h1>GPA planner</h1>
      <p class="lede">Set the GPA you're aiming for and see what the rest of your degree needs to average.</p>
    </div>
    <dl class="stats stats-1">
      <Stat label="Career GPA" value={fmtGpa(summary.gpa)} note={`over ${summary.gpaUnits} units`} />
    </dl>
  </div>

  <div class="split split-even">
    <section class="card" aria-labelledby="goal-heading">
      <h2 id="goal-heading">Your goal</h2>
      <form method="post" action="/api/plan">
        <div class="row">
          <Field
            id="target-gpa"
            label="Target GPA"
            name="targetGpa"
            type="number"
            inputmode="decimal"
            step="0.001"
            min="0"
            max="7"
            placeholder="e.g. 6"
            value={student.targetGpa === null ? undefined : String(student.targetGpa)}
            hint="Out of 7. Blank clears it."
          />
          <Field
            id="degree-units"
            label="Units in your degree"
            name="degreeUnits"
            type="number"
            inputmode="numeric"
            min="6"
            max="600"
            required
            value={String(student.degreeUnits)}
            hint="144 for most 3-year bachelors."
          />
        </div>
        <button type="submit">Save goal</button>
      </form>
    </section>

    <section class="card" aria-labelledby="result-heading">
      <h2 id="result-heading">What the rest of your degree needs</h2>
      {!plan && <p class="muted">Set a target GPA to see what you need from here.</p>}
      {
        plan && (
          <>
            <p class="muted small">
              {plural(plan.remainingUnits, "unit")} left, this semester included (about{" "}
              {plural(plan.semestersLeft, "semester")} at a full load).
            </p>
            {plan.status === "possible" && plan.neededAverage !== null && (
              <>
                <p class="big-number">{plan.neededAverage.toFixed(2)}</p>
                <p>
                  grade points per unit on average to reach {plan.target.toFixed(3)}. That's {describeAverage(plan.neededAverage)}
                  {plan.mix && (
                    <>
                      , for example{" "}
                      {mixLine(plan.mix).map((m, i) => (
                        <>
                          {i > 0 && " and "}
                          {m.courses} × <GradeBadge grade={m.grade as never} tracking />
                        </>
                      ))}{" "}
                      across 6-unit courses
                    </>
                  )}
                  .
                </p>
              </>
            )}
            {plan.status === "secured" && (
              <p>
                <strong>Locked in.</strong> Even if the rest went badly you'd stay at or above {plan.target.toFixed(3)}.
              </p>
            )}
            {plan.status === "out-of-reach" && (
              <p>
                <strong>{plan.target.toFixed(3)} is out of reach from here.</strong> Straight HDs would take your career GPA to{" "}
                {fmtGpa(plan.bestPossible)}.
              </p>
            )}
            {plan.status === "no-units" && <p>No units left to change your GPA.</p>}
            {after && after.status === "possible" && after.neededAverage !== null && (
              <p class="small">
                If you hit this semester's course targets, your other {plural(after.remainingUnits, "unit")} would need{" "}
                <strong>{after.neededAverage.toFixed(2)}</strong>.
              </p>
            )}
            {after && after.status === "secured" && <p class="small">Hitting this semester's course targets would lock it in.</p>}
            {plan.bestPossible !== null && plan.status !== "no-units" && (
              <p class="muted small">
                Your career GPA can finish anywhere from {fmtGpa(plan.worstPossible)} (all fails) to {fmtGpa(plan.bestPossible)} (all
                HDs).
              </p>
            )}
          </>
        )
      }
    </section>
  </div>
  <p class="muted small section-gap">
    Grade points: HD 7, D 6, CR 5, P 4, fail 0. Set course targets on each in-progress course from your
    <a href="/">dashboard</a>.
  </p>
</Layout>
