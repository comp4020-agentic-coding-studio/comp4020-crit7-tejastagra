---
// The GPA planner: set a target GPA and see what the rest of the degree
// has to average to get there.
import Field from "../../components/Field.astro";
import GradeBadge from "../../components/GradeBadge.astro";
import Stat from "../../components/Stat.astro";
import Layout from "../../layouts/Layout.astro";
import { listCourses } from "../../lib/data";
import { fmtGpa, plural } from "../../lib/format";
import type { GradeMix, PlanResult } from "../../lib/grading";
import { summarise } from "../../lib/record";

const student = Astro.locals.student!;
const summary = summarise(student, listCourses(student.id));
const plan = summary.plan;

// translate an average in grade points to the nearest grade words
function describeAverage(avg: number): string {
  if (avg > 6.5) return "mostly HDs";
  if (avg > 6) return "a mix of HDs and Ds";
  if (avg > 5.5) return "mostly Ds";
  if (avg > 5) return "a mix of Ds and CRs";
  if (avg > 4.5) return "mostly CRs";
  if (avg > 4) return "a mix of CRs and Ps";
  return "passes";
}

function mixLine(mix: GradeMix): { grade: string; courses: number }[] {
  return [mix.higher, ...(mix.lower ? [mix.lower] : [])];
}

type Scenario = PlanResult & { remainingUnits: number; mix: GradeMix | null };
const scenarios: { key: string; title: string; intro: string; s: Scenario }[] = [];
if (plan) {
  scenarios.push({
    key: "all",
    title: "Across everything left",
    intro: `Your remaining ${plural(plan.remainingUnits, "unit")}, this semester included.`,
    s: plan,
  });
  if (plan.afterTargets) {
    scenarios.push({
      key: "targets",
      title: "If you hit this semester's course targets",
      intro:
        plan.afterTargets.remainingUnits > 0
          ? `Then your other ${plural(plan.afterTargets.remainingUnits, "unit")} (anything without a target yet) need:`
          : "That's the last of your units.",
      s: plan.afterTargets,
    });
  }
}
---

<Layout title="GPA planner">
  <h1>GPA planner</h1>
  <dl class="stats">
    <Stat label="Career GPA" value={fmtGpa(summary.gpa)} note={`over ${summary.gpaUnits} units`} />
    <Stat label="Units left" value={String(summary.remainingUnits)} note={`of a ${summary.degreeUnits}-unit degree`} />
  </dl>

  <section class="card" aria-labelledby="goal-heading">
    <h2 id="goal-heading" style="margin-top:0">Your goal</h2>
    <form method="post" action="/api/plan">
      <div class="row">
        <Field
          id="target-gpa"
          label="Target GPA"
          name="targetGpa"
          type="number"
          inputmode="decimal"
          step="0.001"
          min="0"
          max="7"
          placeholder="e.g. 6"
          value={student.targetGpa === null ? undefined : String(student.targetGpa)}
          hint="Out of 7. Blank clears it."
        />
        <Field
          id="degree-units"
          label="Units in your degree"
          name="degreeUnits"
          type="number"
          inputmode="numeric"
          min="6"
          max="600"
          required
          value={String(student.degreeUnits)}
          hint="144 for most 3-year bachelors."
        />
      </div>
      <button type="submit">Save goal</button>
    </form>
  </section>

  {
    !plan && (
      <p class="muted">Set a target GPA above to see what you need from here.</p>
    )
  }

  {
    scenarios.map(({ key, title, intro, s }) => (
      <section class="card needed" aria-labelledby={`plan-${key}`}>
        <h2 id={`plan-${key}`} style="margin-top:0">
          {title}
        </h2>
        <p class="muted small">{intro}</p>
        {s.status === "possible" && s.neededAverage !== null && (
          <>
            <p class="big-number">{s.neededAverage.toFixed(2)}</p>
            <p>
              grade points per unit on average, which is {describeAverage(s.neededAverage)}.
              {s.remainingUnits > 0 && (
                <> That's about {plural(Math.ceil(s.remainingUnits / 24), "more semester")} at a full load.</>
              )}
            </p>
            {s.mix && (
              <p>
                One way to get there with 6-unit courses:{" "}
                {mixLine(s.mix).map((m, i) => (
                  <>
                    {i > 0 && " and "}
                    <strong>{m.courses}</strong> × <GradeBadge grade={m.grade as never} />
                  </>
                ))}
                .
              </p>
            )}
          </>
        )}
        {s.status === "secured" && (
          <p>
            <strong>You've got this locked in.</strong> Even if the rest went badly, you'd stay at or above{" "}
            {plan!.target.toFixed(3)}.
          </p>
        )}
        {s.status === "out-of-reach" && (
          <p>
            <strong>Out of reach from here.</strong> Straight HDs would take you to {fmtGpa(s.bestPossible)}. Try a
            target at or below that.
          </p>
        )}
        {s.status === "no-units" && <p>No units left to change your GPA.</p>}
        {s.bestPossible !== null && s.status !== "no-units" && (
          <p class="muted small">
            Range from here: {fmtGpa(s.worstPossible)} (all fails) to {fmtGpa(s.bestPossible)} (all HDs).
          </p>
        )}
      </section>
    ))
  }

  <p class="muted small">
    Many grade mixes reach the same GPA, so this shows the average you need, not a single path. Grade points: HD 7,
    D 6, CR 5, P 4, fail 0. Set course targets on each <a href="/archive/">in-progress course</a> to plan this
    semester.
  </p>
</Layout>
