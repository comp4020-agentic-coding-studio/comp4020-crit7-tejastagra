---
// One assessment item, for its convenor (UI/UX review): release status
// first, then marks for the class, with the spreadsheet upload and the
// item's own settings behind disclosures.
import Field from "../../../../../../components/Field.astro";
import StatusChip from "../../../../../../components/StatusChip.astro";
import ItemFields from "../../../../../../components/staff/ItemFields.astro";
import Layout from "../../../../../../layouts/Layout.astro";
import { getOffering, scoreKey } from "../../../../../../lib/data";
import { fmtMark } from "../../../../../../lib/format";
import { termLabel } from "../../../../../../lib/record";

const staff = Astro.locals.user!;
const offering = getOffering(staff.id, Number(Astro.params.id));
const item = offering?.items.find((i) => i.id === Number(Astro.params.itemId));
if (!offering || !item) return new Response("Not found", { status: 404 });

const base = `/api/staff/offerings/${offering.id}/items/${item.id}`;
const students = offering.enrolments.length;
const marked = offering.enrolments.filter((e) => offering.scores.has(scoreKey(item.id, e.id))).length;
const unmarked = students - marked;
// an example that's valid for this item, whatever it's out of
const example = `u1234567,${fmtMark(Math.round(item.outOf * 0.75 * 2) / 2)}`;
---

<Layout title={`${item.name}, ${offering.code} (staff)`}>
    <p class="small"><a href={`/staff/offerings/${offering.id}/`}>← {offering.code}</a></p>
    <h1>{item.name}</h1>
    <p class="lede">
      {offering.code} · {termLabel(offering.term, offering.year)} · {fmtMark(item.weight)}% of the course · out of {fmtMark(item.outOf)}
    </p>

  <div class="detail-layout">
    <section class="card detail-side" aria-labelledby="release-heading">
      <div class="item-top">
        <h2 id="release-heading" style="margin:0">Release</h2>
        <StatusChip kind={item.released ? "done" : "todo"} label={item.released ? "Released" : "Not released"} />
      </div>
      <div class="item-top" style="margin-top:0.75rem">
        <form method="post" action={base}>
          <input type="hidden" name="_action" value={item.released ? "hide" : "release"} />
          <button type="submit" class={item.released ? "button-secondary" : ""}>
            {item.released ? "Unrelease" : "Release to students"}
          </button>
        </form>
      </div>
      <p class="small" style="margin:0.5rem 0 0">
        {marked} of {students} students have a mark.
        {!item.released && " Students see this item as \"Not released\" until you release it."}
        {unmarked > 0 && students > 0 && ` Anyone without a mark will see "No mark" once it's released.`}
      </p>
    </section>

    <div class="detail-main">
    <section id="marks" aria-labelledby="marks-heading">
      <h2 id="marks-heading" style="margin-top:0">Marks</h2>
      {students === 0 && <div class="empty"><p>Enrol students on the <a href={`/staff/offerings/${offering.id}/students/`}>class list</a> first.</p></div>}
      {
        students > 0 && (
          <form method="post" action={base}>
            <input type="hidden" name="_action" value="save-marks" />
            {/* a table on purpose: many marks typed in one tab order (visual-design.md) */}
            <table class="rows">
              <thead>
                <tr>
                  <th scope="col">Student</th>
                  <th scope="col">Mark / {fmtMark(item.outOf)}</th>
                </tr>
              </thead>
              <tbody>
                {offering.enrolments.map((e) => {
                  const score = offering.scores.get(scoreKey(item.id, e.id));
                  return (
                    <tr>
                      <td class="course-cell">
                        <label for={`score-${e.id}`}>
                          {e.name}
                        </label>
                        <span>{e.uniId}</span>
                      </td>
                      <td style="width:8rem">
                        <input
                          id={`score-${e.id}`}
                          name={`score-${e.id}`}
                          type="number"
                          inputmode="decimal"
                          step="any"
                          min="0"
                          max={String(item.outOf)}
                          value={score === undefined ? undefined : String(score)}
                        />
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
            <div class="actions" style="margin-top:0.5rem">
              <button type="submit">Save marks</button>
              <span class="muted small">Leave a box empty for no mark.</span>
            </div>
          </form>
        )
      }
    </section>

    <details class="disclose section-gap" id="upload">
      <summary>Upload from a spreadsheet instead</summary>
      <div class="card" style="margin:0">
        <form method="post" action={base} enctype="multipart/form-data">
          <input type="hidden" name="_action" value="upload-marks" />
          <Field
            id="marks-file"
            label="CSV file"
            name="file"
            type="file"
            accept=".csv,text/csv,text/plain"
            hint={`Columns: uni_id, mark (out of ${fmtMark(item.outOf)}). A header row is fine; an empty mark clears it.`}
          />
          <div class="field">
            <label for="marks-csv">Or paste it</label>
            <textarea id="marks-csv" name="csv" rows="5" placeholder={example}></textarea>
          </div>
          <button type="submit">Upload marks</button>
        </form>
      </div>
    </details>

    <details class="disclose section-gap" id="item-details">
      <summary>Edit or delete this item</summary>
      <div class="card" style="margin:0">
        <form method="post" action={base}>
          <input type="hidden" name="_action" value="update" />
          <ItemFields idPrefix="edit" item={item} />
          <button type="submit">Save item</button>
        </form>
        <form method="post" action={base} style="margin-top:1rem">
          <input type="hidden" name="_action" value="delete" />
          <button type="submit" class="button-danger">Delete {item.name} and its marks</button>
        </form>
      </div>
    </details>
    </div>
  </div>
</Layout>
