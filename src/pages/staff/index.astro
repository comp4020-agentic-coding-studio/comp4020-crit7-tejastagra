---
// A convenor's courses: this session's offerings first, as boxes that say
// what's left to do; past offerings behind one disclosure (UI/UX review).
import OfferingCard from "../../components/staff/OfferingCard.astro";
import OfferingForm from "../../components/staff/OfferingForm.astro";
import Layout from "../../layouts/Layout.astro";
import { isDemoAccount, listOfferings } from "../../lib/data";
import { termLabel } from "../../lib/record";
import { TERMS } from "../../lib/schema";

const staff = Astro.locals.user!;
const offerings = listOfferings(staff.id).sort(
  (a, b) => b.year - a.year || TERMS.indexOf(b.term) - TERMS.indexOf(a.term) || a.code.localeCompare(b.code),
);
const sessions = [...new Set(offerings.map((o) => `${o.year}-${o.term}`))].map((key) => {
  const list = offerings.filter((o) => `${o.year}-${o.term}` === key);
  return { key, label: termLabel(list[0].term, list[0].year), list };
});
const [latest, ...past] = sessions;
const pastCount = past.reduce((n, s) => n + s.list.length, 0);
---

<Layout title="My courses">
  <h1>My courses</h1>
  <p class="lede">Hi, {staff.name}. Set up assessment, upload marks, and release results to your students.</p>

  {offerings.length === 0 && <div class="empty"><p>You don't convene any courses yet. Create one below.</p></div>}

  {
    latest && (
      <section aria-labelledby="current-heading">
        <h2 id="current-heading">{latest.label}</h2>
        <ul class="course-list">
          {latest.list.map((o) => (
            <OfferingCard offering={o} />
          ))}
        </ul>
      </section>
    )
  }

  <details class="disclose section-gap" id="new-offering" open={offerings.length === 0}>
    <summary>New course</summary>
    <div class="card narrow" style="margin:0">
      <OfferingForm action="/api/staff/offerings" submitLabel="Create course" idPrefix="new" />
    </div>
  </details>

  {
    past.length > 0 && (
      <details class="section section-gap">
        <summary>
          Past courses <span class="muted">({pastCount})</span>
        </summary>
        {past.map((s) => (
          <section aria-labelledby={`s-${s.key}`}>
            <h3 id={`s-${s.key}`}>{s.label}</h3>
            <ul class="course-list">
              {s.list.map((o) => (
                <OfferingCard offering={o} />
              ))}
            </ul>
          </section>
        ))}
      </details>
    )
  }

  {
    isDemoAccount(staff.uniId) && (
      <form method="post" action="/api/demo/reset" class="small muted section-gap">
        This is the shared demo account. <button type="submit" class="link-button">Reset demo data</button>
      </form>
    )
  }
</Layout>
