---
// A convenor's courses, newest session first, with what's left to do in
// each: items to release, grades to set.
import OfferingForm from "../../components/staff/OfferingForm.astro";
import Layout from "../../layouts/Layout.astro";
import { isDemoAccount, listOfferings } from "../../lib/data";
import { termLabel } from "../../lib/record";
import { TERMS } from "../../lib/schema";

const staff = Astro.locals.user!;
const offerings = listOfferings(staff.id).sort(
  (a, b) => b.year - a.year || TERMS.indexOf(b.term) - TERMS.indexOf(a.term) || a.code.localeCompare(b.code),
);
const sessions = [...new Set(offerings.map((o) => `${o.year}-${o.term}`))].map((key) => {
  const list = offerings.filter((o) => `${o.year}-${o.term}` === key);
  return { key, label: termLabel(list[0].term, list[0].year), list };
});
---

<Layout title="My courses">
  <h1>My courses</h1>
  <p class="lede">Hi, {staff.name}. Set up assessment, upload marks, and release results to your students.</p>

  {offerings.length === 0 && <p class="muted">You don't convene any courses yet. Create one below.</p>}
  <div class="grid-auto">
  {
    sessions.map((s) => (
      <section aria-labelledby={`s-${s.key}`}>
        <div class="table-head"><h2 id={`s-${s.key}`}>{s.label}</h2></div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Course</th>
                <th scope="col" class="num">Students</th>
                <th scope="col" class="num">Released</th>
                <th scope="col" class="num">Graded</th>
              </tr>
            </thead>
            <tbody>
              {s.list.map((o) => (
                <tr>
                  <td class="course-cell">
                    <a href={`/staff/offerings/${o.id}/`}>{o.code}</a>
                    <span>{o.title}</span>
                  </td>
                  <td class="num">{o.students}</td>
                  <td class="num">
                    {o.released}/{o.items}
                  </td>
                  <td class="num">
                    {o.graded}/{o.students}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }
  </div>
  <div class="narrow" style="margin:2rem 0 0">
  <section class="card" id="new-offering" aria-labelledby="new-heading">
    <h2 id="new-heading">Create a course offering</h2>
    <OfferingForm action="/api/staff/offerings" submitLabel="Create offering" idPrefix="new" />
  </section>

  {
    isDemoAccount(staff.uniId) && (
      <form method="post" action="/api/demo/reset" class="small muted" style="margin-top:1.5rem">
        This is the shared demo account. <button type="submit" class="link-button">Reset demo data</button>
      </form>
    )
  }
  </div>
</Layout>
