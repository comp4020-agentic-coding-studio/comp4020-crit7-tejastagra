---
// The archive: every course, newest session first, with the GPA for each
// session and for the whole career.
import CourseCard from "../../components/CourseCard.astro";
import Stat from "../../components/Stat.astro";
import Layout from "../../layouts/Layout.astro";
import { listCourses } from "../../lib/data";
import { fmtGpa, plural } from "../../lib/format";
import { summarise } from "../../lib/record";

const student = Astro.locals.student!;
const summary = summarise(student, listCourses(student.id));
---

<Layout title="Archive">
  <h1>Archive</h1>
  <dl class="stats">
    <Stat label="Career GPA" value={fmtGpa(summary.gpa)} note={`${summary.points} points ÷ ${summary.gpaUnits} units`} />
    <Stat label="Courses" value={String(summary.courses.length)} note={plural(summary.semesters.length, "session")} />
  </dl>
  <p class="muted small">
    GPA is worked out the ANU way: grade points × units, summed and divided by units, to three decimal places. Fails
    count as units with 0 points; results like WD and CRS don't count at all.
    <a href="/readme/">How this works</a>
  </p>
  <p>
    <a class="button button-secondary" href="/courses/new/">Add a course</a>
  </p>
  {summary.semesters.length === 0 && <p class="muted">No courses yet.</p>}
  {
    summary.semesters.map((s) => (
      <section aria-labelledby={`sem-${s.key}`}>
        <div class="semester-head">
          <h2 id={`sem-${s.key}`}>{s.label}</h2>
          <span class="muted small">
            {s.units} units
            {s.gpa !== null && <> · session GPA {fmtGpa(s.gpa)}</>}
            {s.inProgress && <> · in progress</>}
          </span>
        </div>
        <ul class="course-list">
          {s.courses.map((v) => (
            <CourseCard view={v} showNeeded={v.inProgress} />
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
