---
// The archive: every finished course as the same boxes the dashboard uses,
// grouped by session, newest first (visual-design.md: boxes over tables).
// This semester's courses live on the dashboard, so they're not repeated.
import CourseCard from "../../components/CourseCard.astro";
import Stat from "../../components/Stat.astro";
import Layout from "../../layouts/Layout.astro";
import { listStudentCourses } from "../../lib/data";
import { fmtGpa, plural } from "../../lib/format";
import { groupBySemester, summarise } from "../../lib/record";

const student = Astro.locals.user!;
const summary = summarise(student, listStudentCourses(student.uniId));
// filter by course, not session: a course graded early in a still-running
// session belongs here even though its classmates are on the dashboard
const past = groupBySemester(summary.courses.filter((v) => !v.inProgress));
const current = summary.courses.filter((v) => v.inProgress).length;
---

<Layout title="Archive">
  <div class="page-head">
    <div>
      <h1>Archive</h1>
      <p class="lede">
        Every finished course, newest first.
        {current > 0 && <> This semester's {plural(current, "course")} {current === 1 ? "is" : "are"} on your <a href="/">dashboard</a>.</>}
      </p>
    </div>
    <dl class="stats stats-1">
      <Stat label="Career GPA" value={fmtGpa(summary.gpa)} note={`${summary.points} points ÷ ${summary.gpaUnits} units`} />
    </dl>
  </div>
  {past.length === 0 && <div class="empty"><p>No finished courses yet. Once a course's grade is released it moves here.</p></div>}
  {
    past.map((s) => (
      <section aria-labelledby={`sem-${s.key}`} class="section-gap">
        <div class="table-head">
          <h2 id={`sem-${s.key}`}>{s.label}</h2>
          <span class="muted small">{s.gpa !== null ? `Session GPA ${fmtGpa(s.gpa)}` : "No GPA results"}</span>
        </div>
        <ul class="course-list">
          {s.courses.map((v) => (
            <CourseCard view={v} />
          ))}
        </ul>
      </section>
    ))
  }
  <p class="muted small section-gap">
    GPA = grade points × units ÷ units, to three decimals. Fails count; WD and CRS don't. <a href="/readme/">How this works</a>
  </p>
</Layout>
