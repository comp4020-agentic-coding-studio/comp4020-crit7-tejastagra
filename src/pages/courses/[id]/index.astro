---
// One course, as a student sees it (from the UI/UX review): one status box
// (where you stand, your target and what it needs), then one box per
// assessment item, with the what-if inputs inside the unreleased items. The
// what-if is a GET form: scores ride in the query string, nothing is stored
// (docs/harness/architecture.md).
import Field from "../../../components/Field.astro";
import GradeBadge from "../../../components/GradeBadge.astro";
import Layout from "../../../layouts/Layout.astro";
import { getStudentCourse, listStudentCourses } from "../../../lib/data";
import { fmtGpa, fmtMark, fmtPercent, neededScore } from "../../../lib/format";
import { GRADE_NAMES, GRADE_THRESHOLDS, gradeForMark, percentage } from "../../../lib/grading";
import { pointsLabel, readOverrides, summarise, termLabel, viewCourse, whatIf } from "../../../lib/record";

const student = Astro.locals.user!;
const course = getStudentCourse(student.uniId, Number(Astro.params.id));
if (!course) return new Response("Course not found", { status: 404 });

const view = viewCourse(course);
const { standing, releasedGrade, trackingGrade, needed } = view;
const lost = standing.weightMarked - standing.secured;
const presets = Object.entries(GRADE_THRESHOLDS) as [keyof typeof GRADE_THRESHOLDS, number][];
const isPreset = presets.some(([, m]) => m === course.targetMark);
const target = course.targetMark;
const targetLabel = target === null ? null : `${gradeForMark(target)} (${fmtMark(target)})`;

const open = course.assessments.filter((a) => a.score === null);
const canWhatIf = !releasedGrade && open.length > 0;
const overrides = readOverrides(Astro.url.searchParams);
const summary = summarise(student, listStudentCourses(student.uniId));
const scenario = canWhatIf && overrides.size > 0 ? whatIf(course, overrides, summary.released) : null;
const self = `/courses/${course.id}/`;
const back = releasedGrade ? { href: "/archive/", label: "Archive" } : { href: "/", label: "Dashboard" };
---

<Layout title={`${course.code} ${course.title}`}>
  <div class="one-col">
    <p class="small"><a href={back.href}>← {back.label}</a></p>
    <h1>{course.code}</h1>
    <p class="lede" style="margin-bottom:1.5rem">
      {course.title} · {termLabel(course.term, course.year)} · {course.units} units
    </p>

    <section class="card" aria-labelledby="status-heading">
      <h2 id="status-heading" class="visually-hidden">Where you stand</h2>
      {
        releasedGrade && (
          <p>
            <GradeBadge grade={releasedGrade} /> <strong>{GRADE_NAMES[releasedGrade]}</strong> · {pointsLabel(releasedGrade)}
          </p>
        )
      }
      {
        releasedGrade && view.mark !== null && gradeForMark(view.mark) !== releasedGrade &&
          ["HD", "D", "CR", "P", "N"].includes(releasedGrade) && (
            <p class="muted small">
              Your assessment marks add up to {fmtMark(view.mark)} ({gradeForMark(view.mark)}), but your released grade is{" "}
              {releasedGrade}. Final marks are often scaled; the released grade is the one that counts.
            </p>
          )
      }
      {
        !releasedGrade && (
          <>
            {trackingGrade && standing.averageSoFar !== null ? (
              <p>
                <GradeBadge grade={trackingGrade} tracking /> You're averaging <strong>{fmtPercent(standing.averageSoFar)}</strong> on
                the {fmtPercent(standing.weightMarked)} of the course released so far.
              </p>
            ) : (
              <p class="muted">No marks released yet.</p>
            )}
            {standing.totalWeight > 0 && (
              <>
                <div
                  class="progress"
                  role="img"
                  aria-label={`${fmtMark(standing.secured)} marks banked, ${fmtMark(lost)} lost, ${fmtMark(standing.weightRemaining)} still to come`}
                >
                  <span class="secured" style={`width:${standing.secured}%`} />
                  <span class="remaining" style={`left:${standing.weightMarked}%;width:${standing.weightRemaining}%`} />
                </div>
                <ul class="legend" style="margin-bottom:1rem">
                  <li><i style="background:var(--good)" />{fmtMark(standing.secured)} banked</li>
                  <li><i style="background:transparent" />{fmtMark(lost)} lost</li>
                  <li><i style="background:oklch(0.2 0.01 73 / 16%)" />{fmtMark(standing.weightRemaining)} to come</li>
                </ul>
              </>
            )}
            <p id="target">
              {target === null && "Set a target to see what you need on the rest."}
              {needed?.status === "possible" && (
                <>
                  <strong>Target {targetLabel}.</strong> You need <strong>{fmtPercent(needed.neededPercent!)}</strong> on average
                  across the {fmtPercent(standing.weightRemaining)} still to come.
                </>
              )}
              {needed?.status === "secured" && (
                <>
                  <strong>Target {targetLabel}: locked in.</strong> You've banked {fmtMark(standing.secured)} marks, so you reach it
                  even with zero on the rest.
                </>
              )}
              {needed?.status === "out-of-reach" && (
                <>
                  <strong>Target {targetLabel}: out of reach.</strong> Full marks on the rest gets you to{" "}
                  {fmtMark(standing.maxPossible)} at most.
                </>
              )}
              {needed?.status === "finished" && (
                <>
                  <strong>Target {targetLabel}.</strong> Everything's marked: you finished on {fmtMark(standing.secured)}.
                </>
              )}
            </p>
            <details class="disclose" open={target === null}>
              <summary>{target === null ? "Set a target" : "Change target"}</summary>
              <form method="post" action={`/api/courses/${course.id}`}>
                <input type="hidden" name="_action" value="target" />
                <fieldset class="chips">
                  <legend>Aim for</legend>
                  {presets.map(([g, m]) => (
                    <label>
                      <input type="radio" name="target" value={m} checked={target === m} />
                      <span>
                        {g} ({m}+)
                      </span>
                    </label>
                  ))}
                  <label>
                    <input type="radio" name="target" value="" checked={target === null} />
                    <span>No target</span>
                  </label>
                </fieldset>
                <Field
                  id="custom-target"
                  label="Or a specific mark"
                  name="customTarget"
                  type="number"
                  inputmode="decimal"
                  step="any"
                  min="0"
                  max="100"
                  placeholder="e.g. 75"
                  hint="Overrides the choice above."
                  value={target !== null && !isPreset ? String(target) : undefined}
                />
                <button type="submit">Save target</button>
              </form>
            </details>
          </>
        )
      }
    </section>

    <section aria-labelledby="assessments-heading" id="what-if">
      <h2 id="assessments-heading">Assessment</h2>
      {course.assessments.length === 0 && <p class="muted">Your convenor hasn't set up the assessment yet.</p>}
      {
        canWhatIf && (
          <p class="small muted" style="margin-top:-0.5rem">
            Try marks for what's still to come to see where you'd land. Nothing you try is saved or sent to your convenor.
          </p>
        )
      }
      <form method="get" action={`${self}#what-if`}>
        <ul class="item-list">
          {course.assessments.map((a) => (
            <li>
              <div class="item-box">
                <div class="item-top">
                  <div>
                    <div class="item-name">{a.name}</div>
                    <div class="item-sub">
                      {fmtMark(a.weight)}% of course
                      {a.score === null && <> · {a.released ? "No mark" : "Not released"}</>}
                    </div>
                  </div>
                  {a.score !== null && (
                    <div class="item-score">
                      {fmtMark(a.score)} / {fmtMark(a.outOf)}
                      <span>{fmtPercent(percentage(a.score, a.outOf))}</span>
                    </div>
                  )}
                </div>
                {a.score === null && needed?.status === "possible" && (
                  <div class="item-sub">
                    Need {neededScore(needed.neededPercent!, a.outOf)} / {fmtMark(a.outOf)} for your target
                  </div>
                )}
                {a.score === null && canWhatIf && (
                  <div class="field">
                    <label for={`w-${a.id}`}>Try a mark</label>
                    <div class="try-input">
                      <input
                        id={`w-${a.id}`}
                        name={`w${a.id}`}
                        type="number"
                        inputmode="decimal"
                        step="any"
                        min="0"
                        max={String(a.outOf)}
                        value={overrides.has(a.id) ? String(overrides.get(a.id)) : undefined}
                      />
                      <span>/ {fmtMark(a.outOf)}</span>
                    </div>
                  </div>
                )}
              </div>
            </li>
          ))}
        </ul>
        {
          canWhatIf && (
            <div class="actions" style="margin-top:1rem">
              <button type="submit">Work it out</button>
              {scenario && <a href={self}>Clear</a>}
            </div>
          )
        }
      </form>

      {
        scenario && (
          <div class="scenario" role="status">
            <h3>With those marks</h3>
            {scenario.mark !== null && scenario.grade !== null ? (
              <>
                <p>
                  You'd finish on <strong>{fmtMark(scenario.mark)}</strong> <GradeBadge grade={scenario.grade} tracking />{" "}
                  {GRADE_NAMES[scenario.grade]}.
                </p>
                <p>
                  Your career GPA would go from <strong>{fmtGpa(scenario.gpaNow)}</strong> to{" "}
                  <strong>{fmtGpa(scenario.gpaAfter)}</strong>
                  {scenario.gpaNow !== null && scenario.gpaAfter !== null && (
                    <>
                      {" "}
                      (
                      {scenario.gpaAfter >= scenario.gpaNow
                        ? `up ${(scenario.gpaAfter - scenario.gpaNow).toFixed(3)}`
                        : `down ${(scenario.gpaNow - scenario.gpaAfter).toFixed(3)}`}
                      )
                    </>
                  )}
                  .
                </p>
                {target !== null && (
                  <p class="small">
                    {scenario.mark >= target
                      ? `That meets your target of ${fmtMark(target)}.`
                      : `That's ${fmtMark(target - scenario.mark)} short of your target of ${fmtMark(target)}.`}
                  </p>
                )}
              </>
            ) : (
              <>
                <p>
                  You'd have <strong>{fmtMark(scenario.standing.secured)}</strong> marks banked, averaging{" "}
                  {fmtPercent(scenario.standing.averageSoFar ?? 0)}, with {fmtPercent(scenario.standing.weightRemaining)} of the
                  course still to come.
                </p>
                {scenario.needed?.status === "possible" && (
                  <p>
                    To reach your target you'd then need <strong>{fmtPercent(scenario.needed.neededPercent!)}</strong> on the rest.
                  </p>
                )}
                {scenario.needed?.status === "secured" && <p>That would lock in your target.</p>}
                {scenario.needed?.status === "out-of-reach" && <p>Your target would be out of reach.</p>}
                <p class="muted small">Fill in every item to see your final grade and GPA.</p>
              </>
            )}
          </div>
        )
      }
    </section>

    {
      !releasedGrade && (
        <details class="section-gap">
          <summary>How this is worked out</summary>
          <p class="small muted">
            Each item counts for its weight: a mark of 15/20 on a 15% item banks 11.25 course marks. "Need" is the average
            percentage across everything not yet released that lands you on your target; doing better on one item lets you do
            worse on another. It assumes the weights add up to 100% and every item is marked out of its full weight. Hurdles,
            scaling and rounding are up to your convenor, and the released grade is what counts.
          </p>
          {!standing.weightsSumTo100 && standing.totalWeight > 0 && (
            <p class="small muted">This course's weights add up to {fmtMark(standing.totalWeight)}%, not 100%.</p>
          )}
        </details>
      )
    }
  </div>
</Layout>
