---
// One course: its assessment breakdown, the marks entered so far, a target,
// and what's needed on the rest to hit it.
import AssessmentFields from "../../../components/AssessmentFields.astro";
import CourseForm from "../../../components/CourseForm.astro";
import Field from "../../../components/Field.astro";
import GradeBadge from "../../../components/GradeBadge.astro";
import NeededPanel from "../../../components/NeededPanel.astro";
import Layout from "../../../layouts/Layout.astro";
import { getCourse } from "../../../lib/data";
import { fmtMark, fmtPercent } from "../../../lib/format";
import { GRADE_NAMES, GRADE_THRESHOLDS, gradeForMark, percentage } from "../../../lib/grading";
import { pointsLabel, termLabel, viewCourse } from "../../../lib/record";

const student = Astro.locals.student!;
const course = getCourse(student.id, Number(Astro.params.id));
if (!course) return new Response("Course not found", { status: 404 });

const view = viewCourse(course);
const { standing, releasedGrade, trackingGrade, needed } = view;
const base = `/api/courses/${course.id}`;
const lost = standing.weightMarked - standing.secured;
const presets = Object.entries(GRADE_THRESHOLDS) as [keyof typeof GRADE_THRESHOLDS, number][];
const isPreset = presets.some(([, m]) => m === course.targetMark);
---

<Layout title={`${course.code} ${course.title}`}>
  <p class="small"><a href="/archive/">← Archive</a></p>
  <h1>{course.code}</h1>
  <p class="lede" style="margin-bottom:0.25rem">{course.title}</p>
  <p class="muted small">{termLabel(course.term, course.year)} · {course.units} units</p>

  <section class="card" aria-labelledby="result-heading">
    <h2 id="result-heading">
      {releasedGrade ? "Released result" : "Where you're at"}
    </h2>
    {
      releasedGrade && (
        <p>
          <GradeBadge grade={releasedGrade} /> {GRADE_NAMES[releasedGrade]} · {pointsLabel(releasedGrade)}
        </p>
      )
    }
    {
      !releasedGrade && trackingGrade && standing.averageSoFar !== null && (
        <p>
          <GradeBadge grade={trackingGrade} tracking /> You're averaging <strong>{fmtPercent(standing.averageSoFar)}</strong>{" "}
          on the {fmtPercent(standing.weightMarked)} of the course marked so far.
        </p>
      )
    }
    {!releasedGrade && standing.averageSoFar === null && <p class="muted">Nothing marked yet.</p>}
    {
      standing.totalWeight > 0 && (
        <>
          <div class="progress" role="img" aria-label={`${fmtMark(standing.secured)} marks banked, ${fmtMark(lost)} lost, ${fmtMark(standing.weightRemaining)} still to come`}>
            <span class="secured" style={`width:${standing.secured}%`} />
            <span class="remaining" style={`left:${standing.weightMarked}%;width:${standing.weightRemaining}%`} />
          </div>
          <ul class="legend">
            <li><i style="background:var(--good)" />{fmtMark(standing.secured)} banked</li>
            <li><i style="background:#ececf1;border:1px solid #ccc" />{fmtMark(lost)} lost</li>
            <li><i style="background:#d8d8e0" />{fmtMark(standing.weightRemaining)} to come</li>
          </ul>
        </>
      )
    }
    {
      releasedGrade && view.mark !== null && gradeForMark(view.mark) !== releasedGrade && ["HD", "D", "CR", "P", "N"].includes(releasedGrade) && (
        <p class="muted small" style="margin-top:0.5rem">
          Your assessment marks add up to {fmtMark(view.mark)} ({gradeForMark(view.mark)}), but the released grade is{" "}
          {releasedGrade}. Final marks are often scaled; the released grade is the one that counts.
        </p>
      )
    }
  </section>

  {
    !releasedGrade && (
      <section class="card" id="target" aria-labelledby="target-heading">
        <h2 id="target-heading">
          Your target
        </h2>
        <form method="post" action={base}>
          <input type="hidden" name="_action" value="target" />
          <fieldset class="chips">
            <legend>Aim for</legend>
            {presets.map(([g, m]) => (
              <label>
                <input type="radio" name="target" value={m} checked={course.targetMark === m} />
                <span>
                  {g} ({m}+)
                </span>
              </label>
            ))}
            <label>
              <input type="radio" name="target" value="" checked={course.targetMark === null} />
              <span>No target</span>
            </label>
          </fieldset>
          <Field
            id="custom-target"
            label="Or a specific mark"
            name="customTarget"
            type="number"
            inputmode="decimal"
            step="any"
            min="0"
            max="100"
            placeholder="e.g. 75"
            hint="Overrides the choice above."
            value={course.targetMark !== null && !isPreset ? String(course.targetMark) : undefined}
          />
          <button type="submit">Save target</button>
        </form>
      </section>
    )
  }

  {needed && <NeededPanel needed={needed} assessments={course.assessments} />}

  <section id="assessments" aria-labelledby="assessments-heading">
    <h2 id="assessments-heading">Assessments</h2>
    {
      course.assessments.length === 0 && (
        <p class="muted">No assessments yet. Add each item from the course's class summary with its weight.</p>
      )
    }
    {
      course.assessments.map((a) => (
        <article class="card assessment" id={`assessment-${a.id}`} aria-labelledby={`a-${a.id}-name`}>
          <div class="assessment-head">
            <h3 id={`a-${a.id}-name`}>{a.name}</h3>
            <span class="muted small">{fmtMark(a.weight)}% of course</span>
          </div>
          {a.score !== null ? (
            <p style="margin:0.25rem 0 0">
              <strong>
                {fmtMark(a.score)} / {fmtMark(a.outOf)}
              </strong>{" "}
              <span class="muted">({fmtPercent(percentage(a.score, a.outOf))})</span>
            </p>
          ) : (
            <p class="muted" style="margin:0.25rem 0 0">
              Not marked yet
            </p>
          )}
          <form class="score-form" method="post" action={`${base}/assessments/${a.id}`}>
            <input type="hidden" name="_action" value="score" />
            <Field
              id={`score-${a.id}`}
              label={`Mark out of ${fmtMark(a.outOf)}`}
              name="score"
              type="number"
              inputmode="decimal"
              step="any"
              min="0"
              max={String(a.outOf)}
              value={a.score === null ? undefined : String(a.score)}
            />
            <button type="submit" class="button-secondary">
              Save<span class="visually-hidden"> mark for {a.name}</span>
            </button>
          </form>
          <details>
            <summary>Edit or remove<span class="visually-hidden"> {a.name}</span></summary>
            <form method="post" action={`${base}/assessments/${a.id}`}>
              <input type="hidden" name="_action" value="update" />
              <AssessmentFields idPrefix={`edit-${a.id}`} item={a} />
              <div class="actions">
                <button type="submit">Save changes</button>
              </div>
            </form>
            <form method="post" action={`${base}/assessments/${a.id}`} style="margin-top:0.5rem">
              <input type="hidden" name="_action" value="delete" />
              <button type="submit" class="button-danger">
                Remove {a.name}
              </button>
            </form>
          </details>
        </article>
      ))
    }
    {
      course.assessments.length > 0 && !standing.weightsSumTo100 && (
        <p class="muted small">
          Weights so far add up to {fmtMark(standing.totalWeight)}%. Most courses add up to 100%.
        </p>
      )
    }
  </section>

  <section class="card" id="add-assessment" aria-labelledby="add-heading">
    <details open={course.assessments.length === 0}>
      <summary><h2 id="add-heading" style="margin:0;font-size:1.05rem">Add an assessment</h2></summary>
      <form method="post" action={base}>
        <input type="hidden" name="_action" value="add-assessment" />
        <AssessmentFields idPrefix="add" />
        <button type="submit" class="button-block">Add assessment</button>
      </form>
    </details>
  </section>

  <section class="card" id="details" aria-labelledby="details-heading">
    <details>
      <summary><h2 id="details-heading" style="margin:0;font-size:1.05rem">Course details and grade</h2></summary>
      <CourseForm action={base} course={course} submitLabel="Save details" idPrefix="edit" />
      <form method="post" action={base} style="margin-top:1rem">
        <input type="hidden" name="_action" value="delete" />
        <button type="submit" class="button-danger button-block">Delete {course.code} and its marks</button>
      </form>
    </details>
  </section>
</Layout>
