---
// Add or edit a course's details. Used by /courses/new/ and the course page.
import type { Course } from "../lib/data/courses";
import { ALL_GRADES, GRADE_NAMES } from "../lib/grading";
import { TERM_LABELS } from "../lib/record";
import { TERMS } from "../lib/schema";
import Field from "./Field.astro";

interface Props {
  action: string;
  course?: Course;
  submitLabel: string;
  idPrefix: string;
}
const { action, course, submitLabel, idPrefix } = Astro.props;
const thisYear = new Date().getFullYear();
---

<form method="post" action={action}>
  {course && <input type="hidden" name="_action" value="update" />}
  <div class="row">
    <Field
      id={`${idPrefix}-code`}
      label="Course code"
      name="code"
      required
      maxlength="12"
      autocapitalize="characters"
      autocomplete="off"
      placeholder="COMP1100"
      value={course?.code}
    />
    <Field
      id={`${idPrefix}-units`}
      label="Units"
      name="units"
      type="number"
      inputmode="numeric"
      min="1"
      max="48"
      required
      value={String(course?.units ?? 6)}
    />
  </div>
  <Field
    id={`${idPrefix}-title`}
    label="Course name"
    name="title"
    required
    maxlength="120"
    placeholder="Programming as Problem Solving"
    value={course?.title}
  />
  <div class="row">
    <Field
      id={`${idPrefix}-year`}
      label="Year"
      name="year"
      type="number"
      inputmode="numeric"
      min="1994"
      max="2100"
      required
      value={String(course?.year ?? thisYear)}
    />
    <div class="field">
      <label for={`${idPrefix}-term`}>Session</label>
      <select id={`${idPrefix}-term`} name="term" required>
        {TERMS.map((t) => <option value={t} selected={(course?.term ?? "S2") === t}>{TERM_LABELS[t]}</option>)}
      </select>
    </div>
  </div>
  <div class="field">
    <label for={`${idPrefix}-grade`}>Released grade</label>
    <select id={`${idPrefix}-grade`} name="grade" aria-describedby={`${idPrefix}-grade-hint`}>
      <option value="" selected={!course?.grade}>Not released yet (in progress)</option>
      {ALL_GRADES.map((g) => <option value={g} selected={course?.grade === g}>{g} — {GRADE_NAMES[g]}</option>)}
    </select>
    <span class="hint" id={`${idPrefix}-grade-hint`}>
      Leave as "not released" while the course is running, so you can plan what you need.
    </span>
  </div>
  <button type="submit" class="button-block">{submitLabel}</button>
</form>
