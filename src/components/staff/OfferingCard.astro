---
// One offering as a box for its convenor: code, title, and what's left to
// do. The job to do gets the gold "todo" chip (design review R5).
import type { OfferingSummary } from "../../lib/data/staff";
import StatusChip from "../StatusChip.astro";

interface Props {
  offering: OfferingSummary;
}
const { offering: o } = Astro.props;
const done = o.students > 0 && o.graded === o.students;
const status = done ? "Graded" : o.released < o.items ? `${o.items - o.released} not released` : "Grades to set";
---

<li>
  <a class="course-card" href={`/staff/offerings/${o.id}/`}>
    <span class="info">
      <span class="code">{o.code}</span>
      <span class="title">{o.title}</span>
      <span class="meta">
        <span class="nw">{o.students} students</span> · <span class="nw">{o.released} of {o.items} released</span> ·{" "}
        <span class="nw">{o.graded} of {o.students} graded</span>
      </span>
    </span>
    <StatusChip kind={done ? "done" : "todo"} label={status} />
  </a>
</li>
