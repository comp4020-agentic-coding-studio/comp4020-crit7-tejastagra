---
// The fields that describe an assessment item (staff only).
import type { AssessmentItem } from "../../lib/data/staff";
import Field from "../Field.astro";

interface Props {
  idPrefix: string;
  item?: AssessmentItem;
}
const { idPrefix, item } = Astro.props;
---

<Field id={`${idPrefix}-name`} label="Name" name="name" required maxlength="80" placeholder="Final exam" value={item?.name} />
<div class="row">
  <Field id={`${idPrefix}-weight`} label="Weight (%)" name="weight" type="number" inputmode="decimal" step="any" min="0" max="100" required value={item ? String(item.weight) : undefined} />
  <Field id={`${idPrefix}-outof`} label="Marked out of" name="outOf" type="number" inputmode="decimal" step="any" min="0.5" max="1000" required value={String(item?.outOf ?? 100)} />
</div>
